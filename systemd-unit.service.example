[Unit]
Description=Exam portal - FastAPI :8022
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/exam-portal/backend
ExecStart=/opt/exam-portal/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8022
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
